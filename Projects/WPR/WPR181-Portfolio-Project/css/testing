CSS
/* Universal Box-Model Reset */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
 
html {
  scroll-behavior: smooth;
 
  background-image: linear-gradient(
    to right,
    var(--color-bg-dark),
    var(--color-bg-cerulean),
    var(--color-bg-dark)
  );
  background-color: var(--color-primary); /* Dark fallback background */
}
 
/* Custom Properties (Design Tokens) */
:root {
  color-scheme: dark;
 
  /* Color Palette */
  --color-primary: #0a1627;
  --color-primary-lighter: #10243f;
  --color-secondary: #ff6b4a;
  --color-accent: #f4c95d;
 
  --color-bg: #ffffff;
  --color-bg-cerulean: #007ba7;
  --color-bg-dark: #02314e;
  --color-bg-alt: #d1d1d114;
 
  --color-text: #cfcaca;
  --color-text-muted: #6b6b6b;
  --color-text-light: #ffffff;
 
  --color-border: #e0e0e0;
 
  /* Semi-transparent Overlay Values */
  --color-overlay: rgba(0, 0, 0, 0.7);
  --color-overlay-hover: rgba(0, 0, 0, 0.827);
  /* NEW: used behind text sitting on top of the hero photo — replaces the
     old grey "--color-text-muted" hack, which was a text-color token being
     misused as a background */
  --color-hero-caption-bg: rgba(10, 22, 39, 0.55);
 
  /* Fonts
     NOTE: Georgia/Verdana swapped for a pairing that reads more like a
     "premium boutique studio" and less like a 2005 corporate intranet.
     These are web fonts — add this to the <head> of every page:
     <link rel="preconnect" href="https://fonts.googleapis.com">
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
     <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  */
  --font-heading: "Playfair Display", Georgia, serif;
  --font-body: "Inter", Verdana, sans-serif;
 
  /* Spacing */
  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 1.5rem;
  --space-lg: 3rem;
  --space-xl: 5rem;
 
  /* Border radius and shadow */
  --radius: 8px;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
 
  /* Repeating Component Shadows */
  --shadow-button: 0 5px 10px rgba(0, 0, 0, 0.5);
  --shadow-tooltip: 0 5px 10px rgba(0, 0, 0, 0.05);
  --shadow-nav-btn: 0 0px 10px rgba(212, 212, 212, 0.5);
 
  /* Transition Configurations */
  --transition-tooltip: 200ms ease;
  --transition-smooth: 0.2s ease-in-out;
}
 
/* Baseline Typography & Globals */
body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  color: var(--color-text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}
 
h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-heading);
  /* FIX: was var(--color-primary), a very dark navy — nearly invisible
     against the dark page background. Headings now use the light token
     so they're readable everywhere except inside explicitly white
     containers (the pricing table below overrides this on purpose). */
  color: var(--color-text-light);
  line-height: 1.25;
  font-weight: 600;
  margin-bottom: var(--space-sm);
}
 
h1 {
  font-size: 2.5rem;
}
h2 {
  font-size: 2rem;
}
h3 {
  font-size: 1.5rem;
}
 
p {
  margin-bottom: var(--space-sm);
  color: var(--color-text);
}
 
a {
  color: var(--color-secondary);
  text-decoration: none;
  transition: color var(--transition-smooth);
}
 
a:hover,
a:focus {
  color: var(--color-accent);
}
 
ul,
ol {
  list-style: none;
}
 
img {
  max-width: 100%;
  display: block;
}
 
button,
input,
textarea {
  font-family: inherit;
  font-size: inherit;
}
 
main {
  padding: var(--space-lg) var(--space-lg);
  max-width: 1200px;
  margin: 0 auto;
  min-height: 60vh;
}
 
/* ==========================================
   Header & Logo Section 
   ========================================== */
header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background-color: var(--color-primary);
  border-radius: 0px;
}
 
header #gallery-heading {
  text-transform: uppercase;
  font-weight: bold;
  font-size: 0.9rem;
  color: var(--color-accent);
  text-align: center;
}
 
#logo {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 0;
  max-height: 100px;
}
 
nav#gallery + #logo {
  transform: translateY(-40px);
}
 
#logo img {
  width: 100%;
  max-width: 500px;
  aspect-ratio: 4 / 3;
  object-fit: contain;
  display: block;
  z-index: 0;
}
 
/* Navigation Bar */
nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-lg);
  background-color: var(--color-primary);
  box-shadow: var(--shadow);
}
 
nav ul {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-evenly;
  gap: var(--space-md);
  list-style: none;
  margin: 0;
  padding: 0;
  z-index: 10;
}
 
nav#gallery ul {
  display: flex;
  justify-content: flex-end;
}
 
nav a {
  position: relative;
  background-color: var(--color-primary);
  padding: 1em;
  border-radius: 50%;
  width: 50px;
  height: 50px;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: var(--shadow-nav-btn);
}
 
nav a svg {
  height: 32px;
  fill: var(--color-text-light);
}
 
nav a::before {
  content: attr(data-nav);
  position: absolute;
  background-color: var(--color-primary);
  color: var(--color-secondary);
  text-decoration: none;
  padding: 0.5em 1em;
  border-radius: 100px;
  box-shadow: var(--shadow-tooltip);
  transform: translateY(30px) rotate(-25deg);
  opacity: 0;
  transition: var(--transition-tooltip);
  pointer-events: none;
  white-space: nowrap;
}
 
nav a::after {
  content: "";
  position: absolute;
  height: 0;
  width: 0;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-top: 10px solid var(--color-primary);
  transform: translateY(-10px) translateX(15px) rotate(25deg);
  opacity: 0;
  transition: var(--transition-tooltip);
  pointer-events: none;
}
 
nav a:hover {
  box-shadow: 0 0px 30px var(--color-secondary);
}
 
nav a:hover svg {
  fill: var(--color-secondary);
}
 
nav a:hover::before {
  transform: translateY(54px) rotate(0);
  opacity: 1;
}
 
nav a:hover::after {
  transform: translateY(28px) translateX(0px) rotate(0);
  opacity: 1;
}
 
#active svg {
  fill: rgb(86, 86, 86);
}
 
#active {
  box-shadow: 0 0px 5px rgba(96, 95, 95, 0.563);
}
 
#active:hover::after {
  opacity: 0;
}
 
#active:hover::before {
  opacity: 0;
}
 
/* Footer Configuration */
footer {
  background-color: var(--color-primary);
  color: var(--color-text-light);
  text-align: center;
  padding: var(--space-md) var(--space-lg);
  margin-top: var(--space-xl);
}
 
footer p {
  color: var(--color-text-light);
  margin-bottom: var(--space-xs);
}
 
.social-container {
  gap: 20px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  align-items: center;
  justify-items: center;
}
 
.social-container a {
  position: relative;
  background-color: white;
  padding: 1em;
  border-radius: 50%;
  height: 64px;
  width: 64px;
  box-sizing: border-box;
  box-shadow: var(--shadow-button);
}
 
.social-container a svg {
  height: 32px;
  fill: black;
}
 
.social-container a::before {
  content: attr(data-social);
  position: absolute;
  background-color: var(--social-color);
  color: white;
  text-decoration: none;
  padding: 0.5em 1em;
  border-radius: 100px;
  box-shadow: var(--shadow-tooltip);
  transform: translateY(-30px) rotate(25deg);
  opacity: 0;
  transition: var(--transition-tooltip);
  white-space: nowrap;
  pointer-events: none;
}
 
.social-container a:hover {
  background-color: var(--social-color);
}
 
.social-container a:hover svg {
  fill: white;
}
 
.social-container a::after {
  content: "";
  position: absolute;
  height: 0;
  width: 0;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-top: 10px solid var(--social-color);
  transform: translateY(-10px) translateX(-10px) rotate(25deg);
  opacity: 0;
  transition: var(--transition-tooltip);
  pointer-events: none;
}
 
.social-container a:hover::before {
  transform: translateY(-64px) translateX(-25px) rotate(0);
  opacity: 1;
}
 
.social-container a:hover::after {
  transform: translateY(-24px) translateX(-23px) rotate(0);
  opacity: 1;
}
 
/* ==========================================
   Link Containers
   ========================================== */
.link-container a {
  position: relative;
  background-color: rgba(5, 5, 5, 0.523);
  padding: 0.5em;
  margin: 10px;
  border-radius: 50%;
  height: 32px;
  width: 32px;
  box-sizing: border-box;
  box-shadow: var(--shadow-button);
}
 
.link-container a svg {
  height: 16px;
  fill: white;
}
 
.link-container a::before {
  content: attr(data-link);
  position: absolute;
  background-color: var(--link-color);
  color: white;
  text-decoration: none;
  padding: 0.5em 1em;
  border-radius: 100px;
  box-shadow: var(--shadow-tooltip);
  transform: translateY(-30px) rotate(25deg);
  opacity: 0;
  transition: var(--transition-tooltip);
  pointer-events: none;
  white-space: nowrap;
}
 
.link-container a:hover {
  background-color: var(--link-color);
  fill: var(white);
}
 
.link-container a:hover svg {
  fill: white;
}
 
.link-container a::after {
  content: "";
  position: absolute;
  height: 0;
  width: 0;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-top: 10px solid var(--link-color);
  transform: translateY(-10px) translateX(-20px) rotate(25deg);
  opacity: 0;
  transition: var(--transition-tooltip);
  pointer-events: none;
}
 
.link-container a:hover::before {
  transform: translateY(-55px) translateX(-40px) rotate(0);
  opacity: 1;
}
 
.link-container a:hover::after {
  transform: translateY(-15px) translateX(-20px) rotate(0);
  opacity: 1;
}
 
/* ==========================================
   Home Page Layouts 
   ========================================== */
section.hero {
  margin: 10px;
}
 
div.hero-inner {
  display: grid;
  /* FIX: repeat(4, 1fr) forced four equal-height rows with no minimum
     height, so the block just shrank to fit content unpredictably.
     auto rows + a gap + real padding gives it consistent, controllable
     vertical rhythm instead. */
  grid-template-rows: auto;
  gap: var(--space-sm);
  padding: var(--space-xl) var(--space-lg);
  justify-items: center;
  align-items: center;
  /* FIX: 20% radius on a large rectangle produced a pinched/oval look.
     A fixed value gives clean rounded corners regardless of size. */
  border-radius: 24px;
  background-image: url(../assets/images/Hero.png);
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  position: relative;
  font-family: var(--font-body);
}
 
div.hero-inner h1,
div.hero-inner p {
  text-align: center;
}
 
div.hero-inner h1 {
  background-color: var(--color-primary-lighter);
  padding: 0.75em 1.25em;
  margin: 10px;
  border-radius: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
}
 
div.hero-inner h1 span {
  text-transform: uppercase;
  font-weight: bold;
  font-size: 0.9rem;
  color: var(--color-accent);
}
 
div.hero-inner p {
  /* FIX: was `color: aliceblue` on `background: var(--color-text-muted)`
     — a text-color token misused as a background, plus an off-brand
     named color. Now both pull from the existing brand palette. */
  color: var(--color-text-light);
  background-color: var(--color-hero-caption-bg);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius);
  max-width: 60ch;
}
 
div.hero-inner:hover {
  padding: 0;
  /* FIX: `salmon` + a hard red glow read as an error/alert state and
     clashed with the brand palette. Swapped for the existing secondary
     (a warm orange already close to salmon) so the hover state still
     feels intentional rather than alarming. */
  border: 1px dashed var(--color-secondary);
  box-shadow: 0 0px 30px rgba(255, 107, 74, 0.6);
}
 
.services-showcase {
  margin-top: 30px;
  text-align: center;
}
 
.services-showcase h2 {
  color: var(--color-secondary);
}
 
.services-grid {
  display: flex;
  gap: var(--space-lg);
  justify-content: center;
  flex-wrap: wrap;
  margin-top: var(--space-md);
}
 
.service-card {
  flex: 1;
  max-width: 500px;
  background-color: var(--color-bg-cerulean);
  border: 1px solid var(--color-accent);
  border-radius: var(--radius);
  padding: var(--space-md);
  box-shadow: 0 0 15px black;
  text-align: center;
  transition: transform var(--transition-smooth);
}
 
.service-card:hover {
  transform: translateY(-4px);
}
 
.testimonials {
  margin: var(--space-xl) 0;
  text-align: center;
}
 
.testimonials h2 {
  color: var(--color-secondary);
}
 
.testimonials-wrapper {
  max-width: 800px;
  margin: var(--space-md) auto 0;
  background-color: var(--color-bg-cerulean);
  padding: var(--space-md) var(--space-lg);
  border-left: 5px solid var(--color-secondary);
  border-radius: var(--radius);
  text-align: left;
}
 
.testimonials blockquote p {
  font-style: italic;
  font-size: 1.1rem;
  color: var(--color-text);
  margin-bottom: var(--space-xs);
}
 
.testimonials blockquote cite {
  font-weight: bold;
  font-size: 0.95rem;
  color: var(--color-text-light);
}
 
.promo-banner {
  background-color: var(--color-primary-lighter);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-lg) var(--space-lg);
  margin: var(--space-xl) 0 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-md);
}
 
.promo-content h2 {
  margin-bottom: var(--space-xs);
  color: var(--color-text-light);
}
 
/* ==========================================
   Gallery Section Layout 
   ========================================== */
.Container {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  margin: 50px auto;
  width: min(1200px, 95%);
  height: auto;
  border: 2px solid var(--color-secondary);
  border-radius: 20px;
  gap: 0.5em;
  flex-grow: 1;
}
 
.Container > article {
  position: relative;
  background-color: var(--color-bg-cerulean);
  padding: 0.25em 0.5em;
  border-radius: 5px;
  border: 2px solid rgb(5, 68, 84);
  overflow: hidden;
  width: 300px;
  height: 300px;
  box-shadow: 0 0px 8px var(--color-overlay-hover);
  transition: 400ms ease;
}
 
.Container > article img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
  display: block;
}
 
.Container > article div.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--color-overlay);
  color: white;
  padding: 1.5em;
  box-sizing: border-box;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  opacity: 0;
  transition: 400ms ease;
}
 
.Container > article div.overlay > * {
  color: lightblue;
  display: block;
  flex: 1;
}
 
.Container > article:hover {
  box-shadow: 0 0px 16px var(--color-overlay-hover);
}
 
.Container > article:hover div.overlay {
  opacity: 1;
}
 
/* ==========================================
   About Page Layout & Tables 
   ========================================== */
.about-profile {
  margin-bottom: var(--space-xl);
}
 
.about-profile h1 {
  margin-bottom: var(--space-sm);
  color: var(--color-text-light);
  text-align: center;
}
.about-profile p {
  text-align: center;
}
 
.about-profile .lead {
  font-size: 1.15rem;
  color: var(--color-text);
  font-weight: 500;
  margin-bottom: var(--space-md);
}
 
figure {
  margin: var(--space-md) 0;
  background-color: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-sm);
  box-shadow: var(--shadow);
}
 
figure img {
  border-radius: calc(var(--radius) - 4px);
  width: 100%;
}
 
figcaption {
  font-size: 0.85rem;
  color: var(--color-text-light);
  text-align: center;
  margin-top: var(--space-xs);
  font-style: italic;
}
 
.pricing-matrix {
  margin-top: var(--space-lg);
}
 
.pricing-matrix table {
  width: 100%;
  border-collapse: collapse;
  margin-top: var(--space-md);
  background-color: var(--color-bg);
  color: var(--color-primary);
}
 
.pricing-matrix caption {
  font-family: var(--font-heading);
  font-weight: bold;
  font-size: 1.2rem;
  text-align: left;
  margin-bottom: var(--space-sm);
  color: var(--color-text-light);
}
 
.pricing-matrix th {
  background-color: var(--color-primary);
  color: var(--color-text-light);
  padding: var(--space-sm);
  text-align: left;
}
 
.pricing-matrix td {
  padding: var(--space-sm);
  border-bottom: 1px solid var(--color-border);
  color: var(--color-primary);
}
 
.pricing-matrix tbody tr:hover {
  background-color: var(--color-bg-alt);
}
 
/* ==========================================
   Contact Page Form & Controls 
   ========================================== */
.contact-container {
  max-width: 800px;
  margin: 0 auto;
}
 
.form-header {
  margin-bottom: var(--space-md);
}
 
.booking-form {
  width: 100%;
}
 
.booking-form fieldset {
  position: relative;
  margin-top: 35px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-md);
  background-color: var(--color-bg);
}
 
.booking-form legend {
  position: absolute;
  top: -38px;
  left: 0;
  font-family: var(--font-heading);
  font-weight: bold;
  font-size: 1.2rem;
  color: var(--color-text-light);
  padding: 0;
}
 
.form-group {
  margin-bottom: var(--space-md);
}
 
.form-group label {
  display: block;
  margin-bottom: var(--space-xs);
  color: var(--color-primary);
  font-weight: bold;
}
 
.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background-color: var(--color-bg);
  color: var(--color-primary);
  font-family: inherit;
  font-size: 1rem;
}
 
.form-group textarea {
  resize: vertical;
}
 
.booking-form .btn-primary {
  background-color: var(--color-primary);
  color: var(--color-text-light);
  border: none;
  border-radius: var(--radius);
  padding: 12px 24px;
  cursor: pointer;
  font-weight: bold;
}
 
.booking-form .btn-primary:hover {
  background-color: var(--color-secondary);
}
 
/* ==========================================
   Portfolio Grid Showcase Layout 
   ========================================== */
.portfolio-header {
  text-align: center;
  margin-bottom: var(--space-xl);
}
 
.grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-lg);
  margin-top: var(--space-md);
}
 
.grid-item {
  background-color: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-md);
  box-shadow: var(--shadow);
  text-align: left;
  transition:
    transform var(--transition-smooth),
    box-shadow var(--transition-smooth);
  display: flex;
  flex-direction: column;
}
 
.grid-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
}
 
/* ==========================================
   Transitions 
   ========================================== */
@view-transition {
  navigation: auto;
}
 
::view-transition-group(*),
::view-transition-old(*),
::view-transition-new(*) {
  animation-duration: 0.5s !important;
}
 
@media (prefers-reduced-motion: reduce) {
  ::view-transition-group(*) {
    animation: none !important;
  }
}
 